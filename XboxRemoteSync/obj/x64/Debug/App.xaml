<Application
    x:Class="XboxRemoteSync.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Style TargetType="Page">
            <Setter Property="Background" Value="#101820" />
        </Style>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101820" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#16212D" />
        <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#1B2836" />
        <SolidColorBrush x:Key="AppSidebarSelectedBrush" Color="#1C2B39" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#7FD13B" />
        <SolidColorBrush x:Key="AppMutedBrush" Color="#91A1B2" />
        <SolidColorBrush x:Key="AppDangerBrush" Color="#F45D5D" />
        <SolidColorBrush x:Key="AppInputBorderBrush" Color="#324356" />
        <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#13202C" />
        <SolidColorBrush x:Key="AppInputForegroundBrush" Color="#F3F6F8" />
        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource AppSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AppInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="{StaticResource AppInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppInputForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="{StaticResource AppInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppInputForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Application.Resources>
</Application>

