<Page
    x:Class="XboxRemoteSync.Views.ProfileEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="22" MaxWidth="820">
            <StackPanel>
                <TextBlock Text="Profile Editor" Style="{StaticResource SectionHeaderTextStyle}" />

                <TextBlock Text="Profile Name" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Living Room Library" />

                <TextBlock Text="Protocol" Style="{StaticResource FieldLabelTextStyle}" />
                <ComboBox ItemsSource="{Binding SupportedProtocols}" SelectedItem="{Binding Protocol, Mode=TwoWay}" Margin="0,6,0,0" MinHeight="40" />

                <TextBlock Text="Server" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox Text="{Binding Server, Mode=TwoWay}" PlaceholderText="192.168.1.10 or nas.local" />

                <TextBlock Text="Port" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox Text="{Binding Port, Mode=TwoWay}" PlaceholderText="22 for SFTP, leave blank for default" InputScope="Number" />

                <TextBlock Text="{Binding ShareLabel}" Style="{StaticResource FieldLabelTextStyle}" Visibility="{Binding ShareVisibility}" />
                <TextBox Text="{Binding Share, Mode=TwoWay}" PlaceholderText="{Binding SharePlaceholder}" IsEnabled="{Binding IsShareEnabled}" Visibility="{Binding ShareVisibility}" />

                <TextBlock Text="{Binding RemoteRootLabel}" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox Text="{Binding RemoteRoot, Mode=TwoWay}" PlaceholderText="{Binding RemoteRootPlaceholder}" />

                <TextBlock Text="Username" Style="{StaticResource FieldLabelTextStyle}" />
                <TextBox Text="{Binding Username, Mode=TwoWay}" PlaceholderText="xboxsync" />

                <TextBlock Text="Password" Style="{StaticResource FieldLabelTextStyle}" />
                <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" />

                <TextBlock Text="Destination" Style="{StaticResource FieldLabelTextStyle}" />
                <Button Click="Destination_Click" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DestinationDisplayName}" Foreground="White" />
                        <SymbolIcon Grid.Column="1" Symbol="Folder" Margin="12,0,0,0" />
                    </Grid>
                </Button>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,18,0,0">
                    <Button Click="Save_Click" IsEnabled="{Binding CanSave}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Save" />
                            <TextBlock Text="{Binding SaveButtonText}" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button Click="TestConnection_Click" IsEnabled="{Binding CanTestConnection}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="World" />
                            <TextBlock Text="{Binding TestConnectionButtonText}" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button Click="Back_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Back" />
                            <TextBlock Text="Back" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyTextStyle}" Margin="0,12,0,0" TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
