<Page
    x:Class="TwinSpool.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#0B131C" Padding="16,20">
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <Button x:Name="ProfilesButton" Style="{StaticResource SidebarNavButtonStyle}" Click="Profiles_Click" ToolTipService.ToolTip="Profiles">
                    <FontIcon Glyph="&#xE8FD;" FontSize="32" Foreground="White" />
                </Button>
                <Button x:Name="RunSyncButton" Style="{StaticResource SidebarNavButtonStyle}" Click="RunSync_Click" ToolTipService.ToolTip="Run Sync">
                    <FontIcon Glyph="&#xE895;" FontSize="32" Foreground="White" />
                </Button>
                <Button x:Name="LogsButton" Style="{StaticResource SidebarNavButtonStyle}" Click="Logs_Click" ToolTipService.ToolTip="Logs">
                    <FontIcon Glyph="&#xE7BA;" FontSize="32" Foreground="White" />
                </Button>
            </StackPanel>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Column="1" />
    </Grid>
</Page>
